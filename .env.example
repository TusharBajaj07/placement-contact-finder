# Copy this file to ".env" and fill in your own keys.
# Load it before running, e.g.:   export $(grep -v '^#' .env | xargs)
# (or use python-dotenv). NEVER commit the real .env.

# Google Gemini  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Apollo.io (optional, paid)  -> only needed if you wire up Apollo enrichment
APOLLO_API_KEY=

# --- only used by ARCHIVED scripts (archive/) ---
PRODUCTHUNT_API_TOKEN=
MISTRAL_API_KEY=
